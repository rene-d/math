#!/usr/bin/env python3

from PIL import Image
import numpy as np
from imgcat import imgcat
import imageio
import argparse

parser = argparse.ArgumentParser()
parser.add_argument("R", nargs="?", default=100, type=float)
args = parser.parse_args()

width = 800
height = 800
C = width / 10
R = args.R

for a in range(0, 3000):
    R = a / 100
    im = Image.new("RGB", (width, height), (0, 0, 0))
    P = complex(width / 2, height / 2)

    for x in range(-100, 101, 5):
        for y in range(-100, 101, 5):

            z = np.complex64(x, y) / 10

            z = z * 80 + P
            x0 = int(z.real)
            y0 = int(z.imag)

            # print(zz,x0,y0)

            if 1 <= x0 < width - 1 and 1 <= y0 < height - 1:
                for dx in range(-1, 2):
                    for dy in range(-1, 2):
                        im.putpixel((x0 + dx, y0 + dy), (0, 0, 255))

            z = np.complex64(x, y) / 10

            # inversion
            z = R / (z + 0.0000001)

            z = z * 80 + P
            x0 = int(z.real)
            y0 = int(z.imag)

            # print(zz,x0,y0)

            if 1 <= x0 < width - 1 and 1 <= y0 < height - 1:
                for dx in range(-1, 2):
                    for dy in range(-1, 2):
                        im.putpixel((x0 + dx, y0 + dy), (255, 0, 0))

    imgcat(im, height=40)
